{
  "$schema": "./test_cases.schema.json",
  "version": "1.0",
  "description": "FAgent 测试用例集",
  "updated_at": "2026-04-27",
  
  "test_suites": {
    "market_service": {
      "description": "Market Service 单元测试",
      "module": "agents.common.market",
      "cases": [
        {
          "id": "MS001",
          "name": "A股行情查询-贵州茅台",
          "function": "market_service.get_quote",
          "input": {
            "symbol": "600519"
          },
          "expected": {
            "success": true,
            "fields": ["name", "symbol", "price", "change_pct", "trade_date"]
          },
          "tags": ["a_share", "quote", "smoke"]
        },
        {
          "id": "MS002",
          "name": "A股行情查询-平安银行",
          "function": "market_service.get_quote",
          "input": {
            "symbol": "000001"
          },
          "expected": {
            "success": true,
            "fields": ["name", "symbol", "price"]
          },
          "tags": ["a_share", "quote"]
        },
        {
          "id": "MS003",
          "name": "A股日K线-贵州茅台",
          "function": "market_service.get_kline",
          "input": {
            "symbol": "600519",
            "period": "DAILY",
            "count": 10
          },
          "expected": {
            "success": true,
            "data_count": 10,
            "fields": ["date", "open", "high", "low", "close", "volume"]
          },
          "tags": ["a_share", "kline"]
        },
        {
          "id": "MS004",
          "name": "股票搜索-茅台",
          "function": "market_service.search",
          "input": {
            "keyword": "茅台",
            "limit": 5
          },
          "expected": {
            "success": true,
            "min_results": 1,
            "contains_symbol": "600519"
          },
          "tags": ["search"]
        },
        {
          "id": "MS005",
          "name": "股票搜索-银行",
          "function": "market_service.search",
          "input": {
            "keyword": "银行",
            "limit": 3
          },
          "expected": {
            "success": true,
            "min_results": 1
          },
          "tags": ["search"]
        }
      ]
    },
    
    "market_subagent": {
      "description": "Market SubAgent 集成测试",
      "module": "agents.subagents.market_agent",
      "cases": [
        {
          "id": "MA001",
          "name": "行情查询意图",
          "function": "market_subagent.process",
          "input": {
            "intent": "GET_QUOTE",
            "symbol": "000001"
          },
          "expected": {
            "success": true,
            "has_summary": true
          },
          "tags": ["subagent", "quote"]
        },
        {
          "id": "MA002",
          "name": "趋势分析意图",
          "function": "market_subagent.process",
          "input": {
            "intent": "ANALYZE_TREND",
            "symbol": "600519",
            "count": 30
          },
          "expected": {
            "success": true,
            "has_summary": true,
            "summary_contains": ["涨", "跌", "趋势"]
          },
          "tags": ["subagent", "analysis"]
        },
        {
          "id": "MA003",
          "name": "快捷行情查询",
          "function": "market_subagent.quick_quote",
          "input": {
            "symbol": "600519"
          },
          "expected": {
            "success": true,
            "result_type": "string",
            "contains": ["600519", "贵州茅台"]
          },
          "tags": ["subagent", "quick"]
        }
      ]
    },
    
    "market_api": {
      "description": "Market API 端点测试",
      "module": "agents.api.market",
      "base_url": "http://localhost:8001",
      "requires_server": true,
      "cases": [
        {
          "id": "API001",
          "name": "GET 行情查询",
          "method": "GET",
          "endpoint": "/market/quote/{symbol}",
          "input": {
            "symbol": "600519"
          },
          "expected": {
            "status_code": 200,
            "json_fields": ["success", "summary", "data"]
          },
          "tags": ["api", "quote"]
        },
        {
          "id": "API002",
          "name": "GET K线数据",
          "method": "GET",
          "endpoint": "/market/kline/{symbol}",
          "input": {
            "symbol": "600519",
            "query_params": {
              "count": 5
            }
          },
          "expected": {
            "status_code": 200,
            "json_fields": ["success", "data"]
          },
          "tags": ["api", "kline"]
        },
        {
          "id": "API003",
          "name": "GET 股票搜索",
          "method": "GET",
          "endpoint": "/market/search",
          "input": {
            "query_params": {
              "keyword": "银行",
              "limit": 3
            }
          },
          "expected": {
            "status_code": 200,
            "json_fields": ["success", "results"]
          },
          "tags": ["api", "search"]
        },
        {
          "id": "API004",
          "name": "GET 趋势分析",
          "method": "GET",
          "endpoint": "/market/analysis/{symbol}",
          "input": {
            "symbol": "600519"
          },
          "expected": {
            "status_code": 200,
            "json_fields": ["success", "summary"]
          },
          "tags": ["api", "analysis"]
        }
      ]
    },
    
    "multi_turn_chat": {
      "description": "多轮对话测试",
      "module": "backend.api + agents.api",
      "requires_server": true,
      "base_urls": {
        "backend": "http://localhost:8000",
        "agents": "http://localhost:8001"
      },
      "cases": [
        {
          "id": "CHAT001",
          "name": "技术问答-两轮对话",
          "type": "conversation",
          "steps": [
            {
              "step": 1,
              "action": "create_session",
              "expected": {
                "success": true,
                "has_cid": true
              }
            },
            {
              "step": 2,
              "action": "send_message",
              "input": {
                "message": "你叫什么名字？"
              },
              "expected": {
                "success": true,
                "has_response": true,
                "has_message_ids": true
              }
            },
            {
              "step": 3,
              "action": "send_message",
              "input": {
                "message": "你的基模型是怎么训练的？"
              },
              "expected": {
                "success": true,
                "has_response": true,
                "message_id_incremented": true
              }
            }
          ],
          "tags": ["chat", "multi_turn", "smoke"]
        },
        {
          "id": "CHAT002",
          "name": "日常对话-上下文保持",
          "type": "conversation",
          "steps": [
            {
              "step": 1,
              "action": "create_session",
              "expected": {
                "success": true
              }
            },
            {
              "step": 2,
              "action": "send_message",
              "input": {
                "message": "今天天气怎么样？"
              },
              "expected": {
                "success": true
              }
            },
            {
              "step": 3,
              "action": "send_message",
              "input": {
                "message": "那有什么推荐的室内活动吗？"
              },
              "expected": {
                "success": true,
                "context_aware": true
              },
              "description": "验证 AI 理解'那'指代天气相关上下文"
            }
          ],
          "tags": ["chat", "context"]
        },
        {
          "id": "CHAT003",
          "name": "多会话独立性",
          "type": "multi_session",
          "sessions": [
            {
              "session_id": "A",
              "messages": ["请记住数字 42", "我刚才说的数字是什么？"]
            },
            {
              "session_id": "B", 
              "messages": ["请记住数字 99", "我刚才说的数字是什么？"]
            }
          ],
          "expected": {
            "session_a_remembers": "42",
            "session_b_remembers": "99",
            "sessions_independent": true
          },
          "tags": ["chat", "isolation"]
        },
        {
          "id": "CHAT004",
          "name": "行情工具调用-茅台周行情",
          "type": "conversation",
          "description": "测试 AI 是否能识别行情查询意图并调用工具获取真实数据",
          "steps": [
            {
              "step": 1,
              "action": "create_session",
              "expected": {
                "success": true,
                "has_cid": true
              }
            },
            {
              "step": 2,
              "action": "send_message",
              "input": {
                "message": "查询贵州茅台最近一周的行情"
              },
              "expected": {
                "success": true,
                "has_response": true
              },
              "expected_chain": {
                "route": {
                  "route": "market",
                  "task": "get_kline",
                  "params": {
                    "symbol": "600519",
                    "period": "daily",
                    "count": 5
                  }
                },
                "must": [
                  {
                    "layer": "subagent",
                    "event": "tool_call",
                    "name": "mcp.stock_kline",
                    "params": {
                      "symbol": { "eq": "600519" },
                      "period": { "eq": "daily" },
                      "count": { "eq": 5 },
                      "market": { "eq": "A" }
                    }
                  },
                  {
                    "layer": "mcp",
                    "event": "tool_call",
                    "name": "stock_kline",
                    "params": {
                      "symbol": { "eq": "600519" },
                      "period": { "eq": "daily" },
                      "count": { "eq": 5 },
                      "market": { "eq": "A" }
                    }
                  },
                  {
                    "layer": "datasource",
                    "event": "source_attempt",
                    "name": "local_db",
                    "result": "miss"
                  },
                  {
                    "layer": "datasource",
                    "event": "source_attempt",
                    "name": "rqdata",
                    "result": "hit"
                  },
                  {
                    "layer": "datasource",
                    "event": "api_call",
                    "name": "rqdatac.get_price",
                    "params": {
                      "order_book_ids": { "eq": "600519.XSHG" },
                      "frequency": { "eq": "1d" },
                      "adjust_type": { "eq": "pre" },
                      "start_date": { "exists": true },
                      "end_date": { "exists": true }
                    }
                  },
                  {
                    "layer": "datasource",
                    "event": "api_result",
                    "name": "rqdatac.get_price",
                    "success": true,
                    "result": "hit"
                  },
                  {
                    "layer": "subagent",
                    "event": "llm_call",
                    "name": "analysis_llm",
                    "params": {
                      "model": { "eq": "deepseek-v4-pro" }
                    }
                  }
                ],
                "forbid": [
                  {
                    "layer": "subagent",
                    "event": "tool_call",
                    "name": "mcp.stock_quote"
                  },
                  {
                    "layer": "datasource",
                    "event": "api_call",
                    "name": "ak.stock_zh_a_hist"
                  }
                ],
                "order": [
                  "router.route_decision",
                  "subagent.tool_call:mcp.stock_kline",
                  "mcp.tool_call:stock_kline",
                  "datasource.source_attempt:local_db:miss",
                  "datasource.api_call:rqdatac.get_price",
                  "datasource.api_result:rqdatac.get_price:hit",
                  "datasource.source_attempt:rqdata:hit",
                  "mcp.tool_result:stock_kline:success",
                  "subagent.tool_result:mcp.stock_kline:success",
                  "subagent.llm_call:analysis_llm"
                ]
              }
            },
            {
              "step": 3,
              "action": "send_message",
              "input": {
                "message": "我需要具体的数据，例如成交量是多少，涨跌幅是多少"
              },
              "expected": {
                "success": true,
                "should_use_tool": true,
                "response_contains": ["600519", "涨跌幅"]
              },
              "description": "AI 应识别需要调用行情工具获取真实数据"
            },
            {
              "step": 4,
              "action": "send_message",
              "input": {
                "message": "你可以使用工具查询啊"
              },
              "expected": {
                "success": true,
                "tool_called": true,
                "has_real_data": true
              },
              "description": "AI 应调用 Market 工具并返回真实行情数据"
            }
          ],
          "tags": ["chat", "tool_calling", "market", "regression"]
        }
      ]
    },
    
    "cache": {
      "description": "缓存功能测试",
      "module": "agents.common.market.cache",
      "cases": [
        {
          "id": "CACHE001",
          "name": "缓存命中-第二次查询更快",
          "type": "performance",
          "steps": [
            {
              "step": 1,
              "action": "clear_cache"
            },
            {
              "step": 2,
              "action": "query",
              "input": {"symbol": "600519"},
              "measure": "first_query_time"
            },
            {
              "step": 3,
              "action": "query",
              "input": {"symbol": "600519"},
              "measure": "second_query_time"
            }
          ],
          "expected": {
            "second_query_faster": true,
            "speedup_ratio_min": 2.0
          },
          "tags": ["cache", "performance"]
        },
        {
          "id": "CACHE002",
          "name": "缓存统计",
          "function": "market_cache.get_cache_stats",
          "expected": {
            "returns_dict": true,
            "has_fields": ["hit_count", "miss_count", "item_count"]
          },
          "tags": ["cache", "stats"]
        }
      ]
    }
  },
  
  "tags_description": {
