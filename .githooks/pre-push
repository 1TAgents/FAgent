#!/usr/bin/env sh
set -eu

expected_name=$(git config --get user.name || true)
expected_email=$(git config --get user.email || true)

if [ -z "${expected_name}" ] || [ -z "${expected_email}" ]; then
  echo "pre-push: local git user.name/user.email is not set for this repo." >&2
  echo "Run: scripts/setup_git_identity.sh \"Your Name\" \"your-public-email\"" >&2
  exit 1
fi

zero_sha=0000000000000000000000000000000000000000
tmp_file=$(mktemp)
trap 'rm -f "$tmp_file"' EXIT INT TERM

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ -z "${local_sha:-}" ] || [ "$local_sha" = "$zero_sha" ]; then
    continue
  fi

  if [ -z "${remote_sha:-}" ] || [ "$remote_sha" = "$zero_sha" ]; then
    git rev-list "$local_sha"
  else
    git rev-list "${remote_sha}..${local_sha}"
  fi
done | sort -u > "$tmp_file"

while read -r commit_sha; do
  if [ -z "${commit_sha:-}" ]; then
    continue
  fi

  actual_author_name=$(git show -s --format=%an "$commit_sha")
  actual_author_email=$(git show -s --format=%ae "$commit_sha")
  actual_committer_name=$(git show -s --format=%cn "$commit_sha")
  actual_committer_email=$(git show -s --format=%ce "$commit_sha")

  if [ "$actual_author_name" != "$expected_name" ] || [ "$actual_author_email" != "$expected_email" ]; then
    echo "pre-push: author mismatch in $commit_sha" >&2
    echo "expected: $expected_name <$expected_email>" >&2
    echo "actual:   $actual_author_name <$actual_author_email>" >&2
    exit 1
  fi

  if [ "$actual_committer_name" != "$expected_name" ] || [ "$actual_committer_email" != "$expected_email" ]; then
    echo "pre-push: committer mismatch in $commit_sha" >&2
    echo "expected: $expected_name <$expected_email>" >&2
    echo "actual:   $actual_committer_name <$actual_committer_email>" >&2
    exit 1
  fi
done < "$tmp_file"
