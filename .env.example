# FAgent 环境变量配置示例
# 复制此文件为 .env 并填入真实值

# ==================== LLM 配置 ====================
# 阿里云 Token Plan (MAAS) API 密钥（主模型）
ALIYUN_TOKEN_PLAN_API_KEY=sk-sp-your-api-key-here

# DeepSeek 直连 API
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 默认问答模型
LLM_MODEL=deepseek-v4-pro

# ==================== RQData 配置 ====================
# Ricequant RQData 许可证 URI (可选)
# 格式：tcp://license:YOUR_LICENSE_URI@rqdatad-pro.ricequant.com:16011
# 获取 License: https://www.ricequant.com/
RQDATAC_CONF="tcp://license:YOUR_LICENSE_URI@rqdatad-pro.ricequant.com:16011"

# ==================== 本地行情数据配置 ====================
# live: 只使用在线行情；offline: 只使用本地离线数据；hybrid: 在线失败后回退本地离线数据
FAGENT_MARKET_DATA_MODE=hybrid

# 用固定日期模拟“当前交易日”，便于在离线数据上稳定复测
FAGENT_MARKET_AS_OF_DATE=2026-04-24

# 项目本地行情库。data/ 目录不进入 git，需用导入脚本生成
FAGENT_MARKET_DB_PATH=data/stock_data.db

# QuantMInd 原始数据目录。推荐放在 data/QuantMInd 或做同名软链接
QUANTMIND_DATA_DIR=data/QuantMInd

# ==================== 后端配置 ====================
# Agents 服务地址
AGENTS_BASE_URL=http://localhost:8001

# 数据库路径
DATABASE_PATH=data/conversations.db

# ==================== 日志配置 ====================
# 日志级别 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# 日志目录
LOG_DIR=logs

# ==================== 服务器配置 ====================
# 后端 API 端口
BACKEND_PORT=8000

# Agents 服务端口
AGENTS_PORT=8001

# 前端开发服务器端口
FRONTEND_PORT=5173
