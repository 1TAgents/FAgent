# FAgent 环境变量配置示例
# 复制此文件为 .env 并填入真实值

# ==================== LLM 配置 ====================
# OpenRouter API 密钥 (https://openrouter.ai)
OPENROUTER_API_KEY=sk-your-api-key-here

# OpenRouter API 基础 URL (可选)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ==================== 后端配置 ====================
# Agents 服务地址
AGENTS_BASE_URL=http://localhost:8001

# 数据库路径
DATABASE_PATH=data/conversations.db

# ==================== 日志配置 ====================
# 日志级别 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# 日志目录
LOG_DIR=logs

# ==================== 服务器配置 ====================
# 后端 API 端口
BACKEND_PORT=8000

# Agents 服务端口
AGENTS_PORT=8001

# 前端开发服务器端口
FRONTEND_PORT=5173
